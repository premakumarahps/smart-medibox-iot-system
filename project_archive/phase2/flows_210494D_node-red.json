    {
        "id": "a67b285a24d31cb6",
        "type": "function",
        "z": "775e9173a8f75bce",
        "name": "Update Sliders()",
        "func": "// Default medication preset\nlet defMedData = \n{\n    \"tablet_a\": { \"controlFactor\": 0.6, \"minAngle\": 45 },\n    \"tablet_b\": { \"controlFactor\": 0.8, \"minAngle\": 60 },\n    \"tablet_c\": { \"controlFactor\": 0.5, \"minAngle\": 35 }\n};\n\n// Get the medicine type from the incoming message.\nlet medicineType = msg.payload;\nflow.set(\"medicineType\", medicineType);\nlet minAngle;\nlet controlFactor;\n\nif (medicineType ===\"tablet_a\"){\n    minAngle = defMedData[\"tablet_a\"][\"minAngle\"];\n    controlFactor =  defMedData[\"tablet_a\"][\"controlFactor\"];\n}\nelse if (medicineType ===\"tablet_b\"){\n    minAngle =  defMedData[\"tablet_b\"][\"minAngle\"];\n    controlFactor = defMedData[\"tablet_b\"][\"controlFactor\"];\n}\nelse if (medicineType ===\"tablet_c\"){\n    minAngle =  defMedData[\"tablet_c\"][\"minAngle\"];\n    controlFactor = defMedData[\"tablet_c\"][\"controlFactor\"];\n}\n\nreturn {payload:{\"minAngle\": minAngle, \"controlFactor\": controlFactor}};",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 1120,
        "y": 920,
        "wires": [
            [
                "30693b40eb908b11",
                "92d40a73b9f1540e"
            ]
        ]
    },
