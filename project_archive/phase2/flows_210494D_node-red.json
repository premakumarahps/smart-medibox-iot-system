        "id": "ce06b3514c92a978",
        "type": "function",
        "z": "775e9173a8f75bce",
        "name": "msg pass",
        "func": "// Extract the light source with maximum intensity from the MQTT payload.\nlet maxLightSource = msg.payload;\n\n// Create a formatted message for display (choose your preferred option).\nlet displayMessage = \"Light is strongest on the: \" + maxLightSource; \n\n// Pass the message to the next node in the flow.\nmsg.payload = displayMessage;\n\n// Return the modified message object to continue the flow.\nreturn msg;",
